.define PUBLIC UART_TX_CYCLES_PER_BIT 4

.program uart_tx
.side_set 1 opt pindirs
start:
    nop // set x [data_bits-1] side 0
    pull block
    set pins 0 [UART_TX_CYCLES_PER_BIT-1] side 1
bit_loop:
    out pins 1
    jmp x-- bit_loop [UART_TX_CYCLES_PER_BIT-2]
    nop // set pins 1 [UART_TX_CYCLES_PER_BIT*stop-1]